{
  "name": "personal-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "prebuild": "node scripts/validate-content.ts && node scripts/validate-tools.ts",
    "test": "pnpm run test:repository && pnpm run test:ci-policy && turbo test",
    "test:e2e": "playwright test",
    "test:docker": "node tests/docker/smoke.ts",
    "test:ci-policy": "vitest run tests/repository/ci-policy.test.ts",
    "test:repository": "node --test tests/repository/eslint-config-package.test.ts scripts/validate-tools.test.ts tests/repository/version-policy.test.ts tests/repository/text-policy.test.ts",
    "test:unit": "pnpm run test:repository && turbo test",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.json && pnpm run typecheck:e2e && pnpm run typecheck:docker",
    "typecheck:docker": "tsc --noEmit -p tests/docker/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "validate": "pnpm validate:versions && pnpm validate:text && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "validate:text": "node scripts/verify-text-format.ts",
    "validate:versions": "node scripts/verify-versions.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@kunlun/eslint-config": "workspace:*",
    "@kunlun/jd-skill-radar": "workspace:*",
    "@kunlun/tool-kit": "workspace:*",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "20.11.6",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.10",
    "yaml": "2.9.0"
  }
}
